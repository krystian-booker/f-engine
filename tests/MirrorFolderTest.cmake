# cmake -DFOLDER=<scratch folder> -P MirrorFolderTest.cmake
# cmake/MirrorFolder.cmake in copy mode (how Windows builds stage lualib and
# shaders): a first copy, an update after files are changed, added and
# removed, and removal with ENABLED off.
cmake_minimum_required(VERSION 3.25)
set(source "${FOLDER}/source")
set(destination "${FOLDER}/destination")
file(REMOVE_RECURSE "${FOLDER}")
file(WRITE "${source}/fe/init.lua" "first")
file(WRITE "${source}/fe/old.lua" "old")
file(WRITE "${source}/gone/file.lua" "gone")

function(mirror)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${source}" "-DDESTINATION=${destination}" ${ARGN}
    -P "${CMAKE_CURRENT_LIST_DIR}/../cmake/MirrorFolder.cmake" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "MirrorFolder.cmake failed (${ARGN})")
  endif()
endfunction()
function(expect_same)
  file(GLOB_RECURSE expected LIST_DIRECTORIES true RELATIVE "${source}" "${source}/*")
  file(GLOB_RECURSE actual LIST_DIRECTORIES true RELATIVE "${destination}" "${destination}/*")
  list(SORT expected)
  list(SORT actual)
  if(NOT expected STREQUAL actual)
    message(FATAL_ERROR "Mirrored entries differ: expected '${expected}', got '${actual}'")
  endif()
  foreach(entry IN LISTS expected)
    if(NOT IS_DIRECTORY "${source}/${entry}")
      file(READ "${source}/${entry}" want)
      file(READ "${destination}/${entry}" got)
      if(NOT want STREQUAL got)
        message(FATAL_ERROR "${entry} holds '${got}', not '${want}'")
      endif()
    endif()
  endforeach()
endfunction()

mirror(-DENABLED=1)
expect_same()
file(WRITE "${source}/fe/init.lua" "second")
file(WRITE "${source}/fe/new.lua" "new")
file(REMOVE "${source}/fe/old.lua")
file(REMOVE_RECURSE "${source}/gone")
mirror(-DENABLED=1)
expect_same()
mirror(-DENABLED=0)
if(EXISTS "${destination}")
  message(FATAL_ERROR "ENABLED=0 left ${destination}")
endif()
