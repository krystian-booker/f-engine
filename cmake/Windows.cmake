if(WIN32)
  enable_language(RC)
  add_compile_definitions(NOMINMAX WIN32_LEAN_AND_MEAN)
endif()
if(MSVC)
  add_compile_options(/utf-8)
endif()
function(fengine_windows_manifest target)
  if(NOT WIN32)
    return()
  endif()
  set(manifest "${PROJECT_BINARY_DIR}/fengine.manifest")
  configure_file("${PROJECT_SOURCE_DIR}/apps/runtime/fengine.manifest.in" "${manifest}" @ONLY)
  if(MSVC)
    target_sources(${target} PRIVATE "${manifest}")
  else()
    configure_file("${PROJECT_SOURCE_DIR}/cmake/WindowsManifest.rc.in" "${PROJECT_BINARY_DIR}/${target}_manifest.rc" @ONLY)
    target_sources(${target} PRIVATE "${PROJECT_BINARY_DIR}/${target}_manifest.rc")
  endif()
endfunction()
