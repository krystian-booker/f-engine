# cmake -DSOURCE=<folder> -DDESTINATION=<folder> [-DLINK=ON] [-DENABLED=<0|1>] -P MirrorFolder.cmake
# Makes DESTINATION an exact copy of SOURCE, rewriting only changed files, or
# with LINK a symbolic link to it. Nothing happens when both name the same
# folder. With ENABLED off it removes DESTINATION instead.
# A script starts with no policies set; IN_LIST below needs them.
cmake_minimum_required(VERSION 3.25)
get_filename_component(SOURCE "${SOURCE}" ABSOLUTE)
get_filename_component(DESTINATION "${DESTINATION}" ABSOLUTE)
if(SOURCE STREQUAL DESTINATION)
  return()
endif()
if(DEFINED ENABLED AND NOT ENABLED)
  file(REMOVE_RECURSE "${DESTINATION}")
  return()
endif()
if(LINK)
  if(NOT IS_SYMLINK "${DESTINATION}")
    file(REMOVE_RECURSE "${DESTINATION}")
    get_filename_component(parent "${DESTINATION}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(CREATE_LINK "${SOURCE}" "${DESTINATION}" SYMBOLIC)
  endif()
  return()
endif()
file(GLOB_RECURSE sources LIST_DIRECTORIES true RELATIVE "${SOURCE}" "${SOURCE}/*")
file(GLOB_RECURSE existing LIST_DIRECTORIES true RELATIVE "${DESTINATION}" "${DESTINATION}/*")
foreach(entry IN LISTS existing)
  if(NOT entry IN_LIST sources)
    file(REMOVE_RECURSE "${DESTINATION}/${entry}")
  endif()
endforeach()
file(GLOB_RECURSE sources RELATIVE "${SOURCE}" "${SOURCE}/*")
foreach(file IN LISTS sources)
  get_filename_component(folder "${DESTINATION}/${file}" DIRECTORY)
  file(MAKE_DIRECTORY "${folder}")
  file(COPY_FILE "${SOURCE}/${file}" "${DESTINATION}/${file}" ONLY_IF_DIFFERENT)
endforeach()
