set(FENGINE_LICENSE_DIR "${PROJECT_BINARY_DIR}/licenses")
file(MAKE_DIRECTORY "${FENGINE_LICENSE_DIR}")
function(fengine_license name source)
  if(EXISTS "${source}")
    configure_file("${source}" "${FENGINE_LICENSE_DIR}/${name}.txt" COPYONLY)
  else()
    message(FATAL_ERROR "Missing third-party license for ${name}: ${source}")
  endif()
endfunction()
fengine_license(CPM "${PROJECT_SOURCE_DIR}/cmake/CPM.cmake")
fengine_license(json "${json_SOURCE_DIR}/LICENSE.MIT")
fengine_license(glm "${glm_SOURCE_DIR}/copying.txt")
fengine_license(EnTT "${EnTT_SOURCE_DIR}/LICENSE")
fengine_license(sol2 "${sol2_SOURCE_DIR}/LICENSE.txt")
fengine_license(Lua "${lua_SOURCE_DIR}/doc/readme.html")
fengine_license(cgltf "${cgltf_SOURCE_DIR}/LICENSE")
fengine_license(stb "${stb_SOURCE_DIR}/LICENSE")

if(FENGINE_BUILD_RUNTIME)
  fengine_license(SDL3 "${SDL_SOURCE_DIR}/LICENSE.txt")
  fengine_license(bgfx "${BGFX_DIR}/LICENSE")
  fengine_license(bx "${BX_DIR}/LICENSE")
  fengine_license(bimg "${BIMG_DIR}/LICENSE")
  fengine_license(ImGui "${imgui_SOURCE_DIR}/LICENSE.txt")
  fengine_license(miniaudio "${miniaudio_SOURCE_DIR}/LICENSE")
  foreach(dependency IN ITEMS BGFX BX BIMG)
    file(GLOB_RECURSE notices CONFIGURE_DEPENDS
      "${${dependency}_DIR}/3rdparty/*LICENSE*" "${${dependency}_DIR}/3rdparty/*license*"
      "${${dependency}_DIR}/3rdparty/*COPYING*")
    foreach(notice IN LISTS notices)
      if(NOT IS_DIRECTORY "${notice}")
        file(RELATIVE_PATH relative "${${dependency}_DIR}" "${notice}")
        configure_file("${notice}" "${FENGINE_LICENSE_DIR}/${dependency}/${relative}" COPYONLY)
      endif()
    endforeach()
  endforeach()
endif()

# Layout: bin/ (executables, shaders), bin/lualib (engine Lua library),
# games/ (samples), licenses/, share/doc/fengine.
install(TARGETS fengine_headless RUNTIME DESTINATION bin)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/lualib/" DESTINATION bin/lualib
  PATTERN "tests" EXCLUDE)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/samples/" DESTINATION games
  PATTERN "replays" EXCLUDE PATTERN "tests" EXCLUDE)
install(DIRECTORY "${FENGINE_LICENSE_DIR}/" DESTINATION licenses)
install(FILES "${PROJECT_SOURCE_DIR}/README.md" DESTINATION share/doc/fengine)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/docs/" DESTINATION share/doc/fengine)
if(MSVC)
  set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION bin)
  include(InstallRequiredSystemLibraries)
endif()
set(CPACK_PACKAGE_NAME fengine)
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_FILE_NAME "fengine-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_GENERATOR ZIP)
include(CPack)
